# =============================================================================
# Kafka Agentic Ops PoC — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Configuration ------------------------------------------------------
# The Diagnostic Agent is a real google-adk Agent, routed through LiteLLM.
# Supported providers: openai, anthropic, gemini
# (see agents/common/adk_factory.py)

# OPTIONAL: leave DIAGNOSTIC_LLM_API_KEY empty to run the agent on its
# deterministic fallback (no LLM call at all — same diagnose/fix/verify
# tools called directly, in order).
DIAGNOSTIC_LLM_PROVIDER=openai
DIAGNOSTIC_LLM_MODEL=gpt-4o
DIAGNOSTIC_LLM_API_KEY=sk-your-openai-key-here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MCP Confluent ---
MCP_CONFLUENT_URL=http://mcp-confluent:3000
