# =============================================================================
# Kafka Agentic Ops PoC — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Configuration — one block per agent -------------------------------
# Each agent is a real google-adk Agent and can use a DIFFERENT provider/model.
# Supported providers: openai, anthropic, gemini
# (all providers are routed through LiteLLM — see agents/common/adk_factory.py)

# All three agents below are OPTIONAL: leave the *_LLM_API_KEY empty to run
# that agent on its deterministic fallback (no LLM call at all).

# Diagnostic Agent — identifies the root cause of a Kafka consumer group lag
# Empty key: deterministic pattern-matching on the sampled messages (siret=null).
DIAGNOSTIC_LLM_PROVIDER=openai
DIAGNOSTIC_LLM_MODEL=gpt-4o
DIAGNOSTIC_LLM_API_KEY=sk-your-openai-key-here

# Remediation Agent — applies the SKILL.md kafka-streams-filter procedure
# Empty key: generates the filter from a deterministic Kafka Streams template.
REMEDIATION_LLM_PROVIDER=anthropic
REMEDIATION_LLM_MODEL=claude-sonnet-4-20250514
REMEDIATION_LLM_API_KEY=sk-ant-your-anthropic-key-here

# Replay Agent — enriches and republishes faulty messages via KIP-932
# Empty key: fully deterministic enrichment (simulated 80% success rate).
REPLAY_LLM_PROVIDER=gemini
REPLAY_LLM_MODEL=gemini-2.5-pro
REPLAY_LLM_API_KEY=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MCP Confluent ---
MCP_CONFLUENT_URL=http://mcp-confluent:3000

# --- Share Group Configuration ---
SHARE_GROUP_LOCK_DURATION_MS=30000
SHARE_GROUP_MAX_DELIVERY_ATTEMPTS=5

# --- Enrichment ---
# Simulated success rate when the replay agent tries to recover a missing siret.
ENRICHMENT_SUCCESS_RATE=0.8
